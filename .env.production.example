POSTGRES_DB=cfox
POSTGRES_USER=cfox
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD

AUTH_SECRET_KEY=REPLACE_WITH_RANDOM_64_PLUS_CHARACTER_SECRET
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60

RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_RAZORPAY_WEBHOOK_SECRET
RAZORPAY_KEY_SECRET=REPLACE_WITH_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_USER_ID=1

DEBUG=false
LOG_LEVEL=INFO

ENVIRONMENT=production
ENABLE_API_DOCS=false
AUTH_COOKIE_SECURE=false

AUTH_ISSUER=cfox-api
AUTH_AUDIENCE=cfox-web

AI_MODEL=gemma3:1b
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_TOKENS=120

MAX_REQUEST_BODY_BYTES=1048576

CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173
VITE_API_URL=http://localhost:8000
