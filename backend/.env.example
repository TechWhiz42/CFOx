APP_NAME=CFOx API
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/cfox
CORS_ORIGINS=http://localhost:5173

AUTH_SECRET_KEY=replace-with-a-long-random-secret
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Razorpay Dashboard -> Webhooks -> webhook secret.
RAZORPAY_WEBHOOK_SECRET=replace-with-your-razorpay-webhook-secret
# CFOx user that should own transactions received from this merchant account.
RAZORPAY_WEBHOOK_USER_ID=1
